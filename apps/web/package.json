{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../api/api/openapi.yaml -o src/lib/api.gen.ts && oxfmt src/lib/api.gen.ts",
    "test": "node --experimental-strip-types --no-warnings src/lib/money.test.ts && node --experimental-strip-types --no-warnings src/lib/register.test.ts && node --experimental-strip-types --no-warnings src/lib/keymap.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/recursive": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/oxfmt-config": "^0.1.0",
    "@tanstack/oxlint-config": "^0.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
