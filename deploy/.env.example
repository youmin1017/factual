# Copy to deploy/.env (git-ignored) and fill in. docs/DEPLOYMENT.md explains each.

# Database password; letters and digits only, it goes into a URL (openssl rand -hex 24).
POSTGRES_PASSWORD=

# The address browsers use, without a trailing slash. https marks cookies Secure.
FACTUAL_PUBLIC_URL=https://money.example.com

# 32 random bytes, base64 (openssl rand -base64 32). Keep it: it decrypts the
# stored OIDC client secrets.
FACTUAL_ENCRYPTION_KEY=

# First admin, created on the first start while nobody can log in yet
# (password at least 8 characters). Change the password after logging in;
# these can be removed afterwards.
FACTUAL_BOOTSTRAP_ADMIN_USERNAME=admin
FACTUAL_BOOTSTRAP_ADMIN_PASSWORD=

# Where the app listens on the host (the reverse proxy connects here).
# FACTUAL_LISTEN=127.0.0.1:8080

# The image to run: the one CI publishes by default. Pin a release
# (ghcr.io/youmin1017/factual:1.2.3) or a commit (...:sha-abc1234), or run
# one built here with mise run docker:build (factual:latest).
# FACTUAL_IMAGE=ghcr.io/youmin1017/factual:latest
